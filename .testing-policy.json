{
  "version": 1,
  "agent_hooks": false,
  "required_stages": ["edit", "task-finish", "commit", "push", "pr"],
  "checks": {
    "unit": {
      "kind": "test",
      "argv": ["{python}", "{repo}/scripts/unittest_junit.py", "--start", "{repo}/tests", "--report", "{report}"],
      "timeout": 600,
      "min_executed": 20
    },
    "package": {
      "kind": "command",
      "argv": ["{python}", "{repo}/scripts/package_plugin.py", "--output", "{report}.zip"],
      "timeout": 30
    }
  },
  "stages": {
    "edit": ["unit"],
    "task-finish": ["unit", "package"],
    "commit": ["unit", "package"],
    "push": ["unit", "package"],
    "pr": ["unit", "package"]
  }
}
