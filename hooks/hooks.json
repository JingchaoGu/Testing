{
  "hooks": {
    "SessionStart": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/agent_hook.py\"",
      "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/agent_hook.py\"",
      "timeout": 15,
      "statusMessage": "Loading testing policy"
    }]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/agent_hook.py\"",
      "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/agent_hook.py\"",
      "timeout": 120,
      "statusMessage": "Checking changed code"
    }]}],
    "Stop": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/agent_hook.py\"",
      "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/agent_hook.py\"",
      "timeout": 180,
      "statusMessage": "Verifying task completion"
    }]}]
  }
}
